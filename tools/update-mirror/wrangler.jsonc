{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wenku8-update",
  "main": "index.mjs",
  "build": { "command": "node build-site.mjs" },
  "assets": { "directory": "./public" },
  "compatibility_date": "2026-10-17",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "git.3952039.xyz", "custom_domain": true }],
  "ratelimits": [
    { "name": "READ_LIMITER", "namespace_id": "395203901", "simple": { "limit": 120, "period": 60 } },
    { "name": "DOWNLOAD_LIMITER", "namespace_id": "395203902", "simple": { "limit": 30, "period": 60 } }
  ],
  "durable_objects": { "bindings": [{ "name": "RELEASE_REGISTRY", "class_name": "ReleaseRegistry" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ReleaseRegistry"] }],
  "observability": { "enabled": false }
}
